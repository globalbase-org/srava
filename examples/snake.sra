#!/usr/bin/env srava
include "module/all.sra";   // #3452: 実カーネルを明示ロード
// 蛇: 3D 折れ線まわりに丸断面を掃引(tube)。
//   path = [[[x,y,z], r], ...] 各頂点に位置と半径。
//   くねった経路 + 頭は太く尾は r=0 で尖らせる。両端 r>0 は平キャップ。
export("snake.stl",
  tube([
    [[0.0,  0.0, 0.0], 0.22],   // 頭(平キャップ・やや太)
    [[0.8,  0.5, 0.0], 0.32],   // 首
    [[1.7,  0.8, 0.1], 0.40],   // 胴(最も太い)
    [[2.7,  0.5, 0.2], 0.38],
    [[3.5, -0.1, 0.2], 0.34],
    [[4.3, -0.7, 0.1], 0.28],
    [[5.2, -0.8, 0.0], 0.22],
    [[6.1, -0.4, 0.0], 0.15],
    [[6.9,  0.3, 0.0], 0.08],
    [[7.6,  0.9, 0.0], 0.0 ]    // 尾(r=0 で尖る)
  ], 48));
