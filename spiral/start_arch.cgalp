include "std/math.cgalp";

var pitch = 1; var N = 2; var ctr = 8; var a = 100.0; var r = 25; var d = 8; var m = 0.2/1000;
var ctr_r = (a+r+d)/cos(PI/ctr);
var sp = linspace(PI/ctr,2*PI*N+PI/ctr,N*ctr);
var x = cos(sp)*ctr_r; var y = sin(sp)*ctr_r; var z = linspace(-r/ctr,-2*r*N-r/ctr,N*ctr);
var NN = 10;
var tail = [linspace(a+r+d,a+r+d,NN), linspace(a,10*a,NN), linspace(-2*r*N,-2*r*N-100,NN)];
var pp = concat([[a+r+d,0,0]],transpose([x,y,z]),transpose(tail));
var center = [[0,0,100],[0,0,0],[0,0,-100]];
var params = { fixEnds: 1, dMin : d, maxIter : 1500 };

var b1 = [ {ctrl: pp, radius: [r,m], movable: 1}, {ctrl: center, radius: a, movable: 0} ];
var adj1 = pipe_scene_adjust(b1,0,params);
var b2 = [ {ctrl: adj1.ctrl, radius: [r,m], movable: 1}, {ctrl: center, radius: a, movable: 0} ];
var adj2 = pipe_scene_adjust(b2,0,params);
var cc = adj2.ctrl;

var zlist = \(arr){ map(arr, \(p){ p[2]; }); };
print("START_Z_0..6", map(range2(0,7), \(ii){ cc[ii]; }));

// pin everything except idx 1,2,3,4
var fixrest = concat([0], range2(5,27));
var sparams = { fixEnds: 1, dMin: d, maxIter: 1500, fixed: fixrest };

// (a) relax from the arch
var ra = pipe_adjust(cc, [r,m], sparams);
print("ARCH_Z_0..6", map(range2(0,7), \(ii){ ra.ctrl[ii]; }));
print("ARCH iters", ra.iters, "energy", ra.energy, "clearViol", ra.clearViolation);

// (b) build a monotonic-start init: force P1,P2 z down to a line P0->P3 (keep x,y)
var p0z = cc[0][2]; var p3z = cc[3][2];
var setz = \(p, nz){ [p[0], p[1], nz]; };
var cc_lo = map(range2(0,27), \(ii){
    if (ii == 1) { return setz(cc[1], p0z + (p3z-p0z)*(1.0/3)); }
    if (ii == 2) { return setz(cc[2], p0z + (p3z-p0z)*(2.0/3)); }
    cc[ii];
});
print("LO_INIT_Z_0..6", map(range2(0,7), \(ii){ cc_lo[ii]; }));

// (b) relax from the lowered init
var rb = pipe_adjust(cc_lo, [r,m], sparams);
print("LO_Z_0..6", map(range2(0,7), \(ii){ rb.ctrl[ii]; }));
print("LO iters", rb.iters, "energy", rb.energy, "clearViol", rb.clearViolation);
