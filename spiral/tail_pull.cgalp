include "std/math.cgalp";

var pitch = 1; var N = 2; var ctr = 8; var a = 100.0; var r = 25; var d = 8; var m = 0.2/1000;
var ctr_r = (a+r+d)/cos(PI/ctr);
var sp = linspace(PI/ctr,2*PI*N+PI/ctr,N*ctr);
var x = cos(sp)*ctr_r; var y = sin(sp)*ctr_r; var z = linspace(-r/ctr,-2*r*N-r/ctr,N*ctr);
var NN = 10;
var zlist = \(arr){ map(arr, \(p){ p[2]; }); };

// build pp for a given tail-end depth (tail end z = -2rN - drop), center bottom = -cz
var run = \(drop, cz, polish){
    var tail = [linspace(a+r+d,a+r+d,NN), linspace(a,10*a,NN), linspace(-2*r*N,-2*r*N-drop,NN)];
    var pp = concat([[a+r+d,0,0]],transpose([x,y,z]),transpose(tail));
    var center = [[0,0,100],[0,0,0],[0,0,-1.0*cz]];
    var bodies = [ {ctrl: pp, radius: [r,m], movable: 1}, {ctrl: center, radius: a, movable: 0} ];
    var params = { fixEnds: 1, dMin : d, maxIter : 1500, polish: polish };
    var r1 = pipe_scene_adjust(bodies, 0, params);
    r1.ctrl;
};

var report = \(label, cc){
    print(label, "c1.z=", cc[1][2], " coil bottom idx16.z=", cc[16][2],
          " coil z[8..16]=", map(range2(8,17), \(ii){ cc[ii][2]; }));
};

// baseline pull -200 (original-ish), polish off
report("DROP100  cz100 polish0", run(100, 100, 0));
report("DROP500  cz500 polish0", run(500, 500, 0));   // user's case: tail end -600, center -500
report("DROP2000 cz500 polish0", run(2000, 500, 0));  // pull very hard
print("---- with polish on ----");
report("DROP500  cz500 polish1", run(500, 500, 1));
