include "std/math.cgalp";

var pitch = 1;
var N = 2;
var ctr = 8;
var a = 100.0;
var r = 25;
var d = 8;
var m = 0.2/1000;
var ctr_r = (a+r+d)/cos(PI/ctr);
var sp = linspace(PI/ctr,2*PI*N+PI/ctr,N*ctr);
var x = cos(sp)*ctr_r;
var y = sin(sp)*ctr_r;
var z = linspace(-r/ctr,-2*r*N-r/ctr,N*ctr);

var NN = 10;
var tail = [linspace(a+r+d,a+r+d,NN),
    	    linspace(a,10*a,NN),
	    linspace(-2*r*N,-2*r*N-100,NN)];
var pp = concat([[a+r+d,0,0]],transpose([x,y,z]),transpose(tail));

var center = [	[0,0,100],
    	        [0,0,0],
    	        [0,0,-100]];

var params = {
    fixEnds: 1,
    dMin : d,
    maxIter : 1500
};

var zlist = \(cc){ map(cc, \(p){ p[2]; }); };

print("NPTS", length(pp));
print("ORIG_Z", zlist(pp));

// pass 1
var b1 = [ {ctrl: pp, radius: [r,m], movable: 1},
           {ctrl: center, radius: a, movable: 0} ];
var adj1 = pipe_scene_adjust(b1,0,params);
print("PASS1_Z", zlist(adj1.ctrl));
print("PASS1_iters", adj1.iters, "maxViol", adj1.maxClearViolation, "energy", adj1.energy);

// pass 2 (warm restart)
var b2 = [ {ctrl: adj1.ctrl, radius: [r,m], movable: 1},
           {ctrl: center, radius: a, movable: 0} ];
var adj2 = pipe_scene_adjust(b2,0,params);
print("PASS2_Z", zlist(adj2.ctrl));
print("PASS2_iters", adj2.iters, "maxViol", adj2.maxClearViolation, "energy", adj2.energy);

// pass 3 (warm restart again)
var b3 = [ {ctrl: adj2.ctrl, radius: [r,m], movable: 1},
           {ctrl: center, radius: a, movable: 0} ];
var adj3 = pipe_scene_adjust(b3,0,params);
print("PASS3_Z", zlist(adj3.ctrl));
print("PASS3_iters", adj3.iters, "maxViol", adj3.maxClearViolation, "energy", adj3.energy);
