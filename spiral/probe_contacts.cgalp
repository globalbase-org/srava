include "std/math.cgalp";

var pitch = 1;
var N = 2;
var ctr = 8;
var a = 100.0;
var r = 25;
var d = 8;
var m = 0.2/1000;
var ctr_r = (a+r+d)/cos(PI/ctr);
var sp = linspace(PI/ctr,2*PI*N+PI/ctr,N*ctr);
var x = cos(sp)*ctr_r;
var y = sin(sp)*ctr_r;
var z = linspace(-r/ctr,-2*r*N-r/ctr,N*ctr);
var NN = 10;
var tail = [linspace(a+r+d,a+r+d,NN), linspace(a,10*a,NN), linspace(-2*r*N,-2*r*N-100,NN)];
var pp = concat([[a+r+d,0,0]],transpose([x,y,z]),transpose(tail));
var center = [[0,0,100],[0,0,0],[0,0,-100]];
var params = { fixEnds: 1, dMin : d, maxIter : 1500 };

var b1 = [ {ctrl: pp, radius: [r,m], movable: 1}, {ctrl: center, radius: a, movable: 0} ];
var adj1 = pipe_scene_adjust(b1,0,params);
var b2 = [ {ctrl: adj1.ctrl, radius: [r,m], movable: 1}, {ctrl: center, radius: a, movable: 0} ];
var adj2 = pipe_scene_adjust(b2,0,params);
var cc = adj2.ctrl;

print("NPTS", length(cc));
// self-proximity contacts on converged ctrl. widen reportGap to see near-contacts. hit=[gap,pA,pB].
var hits = pipe_proximity(cc, [r,m], 4*d);
print("NHITS", length(hits));
var i;
for (i = 0; i < length(hits); i = i + 1) {
    print("HIT gap", hits[i][0], "pA", hits[i][1], "pB", hits[i][2]);
}
// scene contacts (vs center cylinder) too
var sc = pipe_scene_proximity([ {ctrl: cc, radius: [r,m], movable: 1}, {ctrl: center, radius: a, movable: 0} ], d);
print("NSCENE", length(sc));
for (i = 0; i < length(sc); i = i + 1) {
    print("SCN gap", sc[i][0], "pA", sc[i][1], "pB", sc[i][2]);
}
