include "std/math.cgalp";

var pitch = 1;
var N = 2;
var ctr = 8;
var a = 100.0;
var r = 25;
var d = 8;
var m = 0.2/1000;
var ctr_r = (a+r+d)/cos(PI/ctr);
var sp = linspace(PI/ctr,2*PI*N+PI/ctr,N*ctr);
var x = cos(sp)*ctr_r;
var y = sin(sp)*ctr_r;
var z = linspace(-r/ctr,-2*r*N-r/ctr,N*ctr);
var NN = 10;
var tail = [linspace(a+r+d,a+r+d,NN), linspace(a,10*a,NN), linspace(-2*r*N,-2*r*N-100,NN)];
var pp = concat([[a+r+d,0,0]],transpose([x,y,z]),transpose(tail));
var center = [[0,0,100],[0,0,0],[0,0,-100]];
var params = { fixEnds: 1, dMin : d, maxIter : 1500 };

var b1 = [ {ctrl: pp, radius: [r,m], movable: 1}, {ctrl: center, radius: a, movable: 0} ];
var adj1 = pipe_scene_adjust(b1,0,params);
var b2 = [ {ctrl: adj1.ctrl, radius: [r,m], movable: 1}, {ctrl: center, radius: a, movable: 0} ];
var adj2 = pipe_scene_adjust(b2,0,params);
var cc = adj2.ctrl;
var zlist = \(arr){ map(arr, \(p){ p[2]; }); };

// build cc_straight: replace idx 17..25 with linear interp between cc[16] and cc[26]
var p16 = cc[16];
var p26 = cc[26];
var seg = p26 - p16;
var head = map(range2(0,17), \(ii){ cc[ii]; });
var mid  = map(range2(17,26), \(ii){ var tt = 1.0*(ii-16)/10.0; p16 + seg*tt; });
var ccs  = concat(head, mid, [p26]);
print("STRAIGHT_IN_Z", zlist(ccs));

var fixspiral = range2(0,17);
var tparams = { fixEnds: 1, dMin: d, maxIter: 1500, fixed: fixspiral };

// relax the mountain (pinned spiral) -> energy of mountain local min
var rm = pipe_adjust(cc, [r,m], tparams);
print("MOUNTAIN_Z", zlist(rm.ctrl));
print("MOUNTAIN_iters", rm.iters, "energy", rm.energy);

// relax the straightened tail (pinned spiral) -> stays straight? or back to mountain?
var rs = pipe_adjust(ccs, [r,m], tparams);
print("RELAXED_Z", zlist(rs.ctrl));
print("RELAXED_iters", rs.iters, "energy", rs.energy);
